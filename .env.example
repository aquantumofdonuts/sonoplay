HTTP_PORT=32488
HOST_IP=<your host IP>
CLIENT_PROFILE=Sonos|DLNA|Chromecast|Generic|Web|Android|iOS|Roku
ENABLE_ONBOARDING_WIZARD=1

# Set to your Plex Media Server's LAN IP if casting breaks after a firewall change
# that removed hairpin NAT / NAT loopback. Plex uses *.plex.direct hostnames for
# local HTTPS connections; some firewalls block that DNS, causing connection failures.
# When set, SonoPlay contacts PMS directly via plain HTTP at this IP, bypassing DNS.
# Also set it for older renderers (e.g. KEF LSX) that reject https://...plex.direct
# stream URLs; they get a plain http:// URL instead.
# Leave unset if DNS resolution is working normally.
# PMS_ADDRESS=192.168.1.x



